# npm run setup:local erzeugt diese Konfiguration für die lokale Vorschau.
# Alle EXPO_PUBLIC_-Werte sind sichtbar. Keine Service-Role- oder OpenAI-Keys!
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=YOUR_LOCAL_PUBLIC_OR_ANON_KEY

# Für ein iPhone: beide URLs auf die erreichbare LAN-IP des Rechners umstellen.
