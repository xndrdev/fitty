# npm run dev:api lädt server/.env; ein gebautes Go-Binary liest Prozessvariablen.
# npm run setup:local erzeugt die lokale Datei mit einem eigenen DB-Passwort.
FITTY_ADDR=127.0.0.1:8787
FITTY_ALLOWED_ORIGINS=http://localhost:8788,http://127.0.0.1:8788
FITTY_DATABASE_URL=postgresql://fitty_api:CHANGE_ME@127.0.0.1:54322/postgres?sslmode=disable
FITTY_SUPABASE_URL=http://127.0.0.1:54321
FITTY_SUPABASE_KEY=YOUR_LOCAL_PUBLIC_OR_ANON_KEY
# Nur im Go-Server für den privaten Bilder-Bucket, niemals EXPO_PUBLIC_.
FITTY_SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SERVICE_ROLE_KEY

# Nur serverseitig. Ohne Schlüssel bleibt das Tagebuch nutzbar.
OPENAI_API_KEY=
FITTY_OPENAI_MODEL=gpt-5-mini

# Für den Zugriff vom iPhone im eigenen WLAN:
# FITTY_ADDR=0.0.0.0:8787
